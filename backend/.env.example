# Backend environment variables

# Application
WEBGUARD_ENV=development
WEBGUARD_DEBUG=true
WEBGUARD_HOST=0.0.0.0
WEBGUARD_PORT=8000

# Database
WEBGUARD_DB_URL=sqlite:///./webguard.db

# Scanner
WEBGUARD_SCAN_TIMEOUT=30
WEBGUARD_MAX_CONCURRENT_SCANS=3

# Demo Mode (set to true for online demo deployment)
WEBGUARD_DEMO_MODE=false
WEBGUARD_DEMO_RATE_LIMIT=5

# Logging
WEBGUARD_LOG_LEVEL=INFO
