# EditorConfig - https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python
[*.py]
indent_size = 4
max_line_length = 88

# JavaScript / TypeScript
[*.{js,jsx,ts,tsx}]
indent_size = 2

# JSON / YAML / Config
[*.{json,yml,yaml,toml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# Makefile (tabs required)
[Makefile]
indent_style = tab

# Docker
[Dockerfile*]
indent_size = 4

# Shell scripts
[*.{sh,bash}]
indent_size = 2

# PowerShell
[*.ps1]
indent_size = 4
