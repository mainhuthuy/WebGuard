# Docker Compose environment overrides — copy to docker/.env (NOT committed)
# `docker compose` auto-loads a .env file from the directory it's run in, so these
# just need to exist at docker/.env; no `env_file:` directive needed.
# Only affects docker-compose.yml (the production profile). Everything here has a
# sensible default already baked into that file — this is for when you need to
# change one without editing the committed compose file.

# Host-side ports (left side of "host:container" in docker-compose.yml)
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Comma-separated list of origins the backend's CORS middleware accepts (default "*").
# A real deployment should set this to the exact origin(s) the frontend is served
# from — see docs/ARCHITECTURE.md section 4 ("Secure by Default").
WEBGUARD_CORS_ORIGINS=*
